    <!-- onboarding -->
    <string name="onboard_tagline">Three steps to give it hands.</string>
    <string name="step1_title">Pair with wireless debugging</string>
    <string name="step1_body">Settings → Developer Options → Wireless Debugging → \
        “Pair with pairing code”. Enter the port and code shown there.</string>
    <string name="step2_title">Spawn the daemon</string>
    <string name="step2_body">Now enter the connect port — the one on the main \
        Wireless Debugging screen (different from the pairing port).</string>
    <string name="step3_title">Accessibility &amp; battery</string>
    <string name="step3_body">Enable BoxAgent in Accessibility Settings so it can \
        read screens and tap. Exclude it from battery optimisation so the agent \
        survives in the background.</string>
