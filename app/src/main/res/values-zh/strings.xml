    <!-- permission guide -->
    <string name="guide_title">权限</string>
    <string name="guide_intro">BoxAgent 依靠一小组系统能力工作。实心点表示已授权——点开未授权项可查看如何开通。</string>
    <string name="guide_required">需要手动开启</string>
    <string name="guide_auto">安装时授予</string>
